<Window x:Class="GrimDawnTeleporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grim Dawn 坐标传送工具"
        Width="1120"
        Height="720"
        MinWidth="920"
        MinHeight="560"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" CornerRadius="10" Background="#18202A">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock Text="Grim Dawn 坐标传送工具" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="StatusText" Margin="0,6,0,0" Foreground="#C8D2DF" Text="启动后会自动检测 x64 游戏进程并附加插件。F6 记录当前位置，F7 传送到选中点。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="当前位置" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="X/Y/Z：" VerticalAlignment="Center" />
                    <TextBlock x:Name="CurrentCoordinateText" Text="尚未读取" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="记录当前位置" Margin="18,0,0,0" Padding="14,7" Click="AddCurrentPoint_Click" />
                    <Button Content="返回上一个位置" Margin="8,0,0,0" Padding="14,7" Click="ReturnLastPosition_Click" />
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="搜索" Padding="12" Margin="12,0,0,0">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="分组" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="新建分组" Foreground="#667085" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="新建" Margin="8,0,0,0" Padding="12,6" Click="CreateGroup_Click" />
                            <TextBox x:Name="NewGroupBox" VerticalContentAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="模糊查询分组" Foreground="#667085" />
                        <TextBox x:Name="GroupSearchBox" Margin="0,6,0,0" VerticalContentAlignment="Center" TextChanged="GroupSearchBox_TextChanged" ToolTip="输入关键字可模糊筛选分组列表和下拉选择" />
                        <Button Content="删除选中分组" Margin="0,8,0,0" Padding="12,6" Click="DeleteGroup_Click" />
                    </StackPanel>

                    <ListBox Grid.Row="2" x:Name="GroupListBox" Margin="0,14,0,0" SelectionChanged="GroupListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,4">
                                    <TextBlock Text="{Binding PointCount}" DockPanel.Dock="Right" Foreground="#667085" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="当前分组" Padding="12" Margin="0,0,0,12">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="SelectedGroupTitle" Text="当前分组：未分组" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox x:Name="GroupComboBox" Width="180" VerticalContentAlignment="Center" IsEditable="True" IsTextSearchEnabled="False" />
                            <Button Content="移动选中坐标" Margin="8,0,0,0" Padding="12,6" Click="AssignSelectedToGroup_Click" />
                            <Button Content="移出分组" Margin="8,0,0,0" Padding="12,6" Click="RemoveSelectedFromGroup_Click" />
                        </StackPanel>
                    </DockPanel>
                </GroupBox>

                <DataGrid Grid.Row="1"
                          x:Name="PointsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CellEditEnding="PointsGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="*" />
                        <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=0.###}" Width="*" />
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=0.###}" Width="*" />
                        <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=0.###}" Width="*" />
                        <DataGridTextColumn Header="区域" Binding="{Binding Area}" Width="*" />
                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="2*" />
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="1.7*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="输出" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputTextBox"
                             MinHeight="58"
                             MaxHeight="110"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" />
                    <Button Grid.Column="1" Content="复制输出" Margin="8,0,0,0" Padding="16,8" Click="CopyOutput_Click" />
                </Grid>
            </GroupBox>

            <Expander Grid.Row="1" Header="高级/调试" Margin="0,8,0,0" IsExpanded="False">
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="检测进程" Margin="6,4,0,0" Padding="14,8" Click="DetectProcess_Click" />
                    <Button Content="附加插件" Margin="6,4,0,0" Padding="14,8" Click="AttachPlugin_Click" />
                    <Button Content="插件状态" Margin="6,4,0,0" Padding="14,8" Click="PluginStatus_Click" />
                    <Button Content="核心符号" Margin="6,4,0,0" Padding="14,8" Click="PluginCoreSymbols_Click" />
                    <Button Content="符号诊断" Margin="6,4,0,0" Padding="14,8" Click="PluginDiagnoseSymbols_Click" />
                    <Button Content="AOB 诊断" Margin="6,4,0,0" Padding="14,8" Click="PluginDiagnoseAob_Click" />
                    <Button Content="插件坐标" Margin="6,4,0,0" Padding="14,8" Click="PluginReadPosition_Click" />
                    <Button Content="启动 x86" Margin="6,4,0,0" Padding="14,8" Click="StartGameX86_Click" />
                    <Button Content="启动 x64" Margin="6,4,0,0" Padding="14,8" Click="StartGameX64_Click" />
                    <Button Content="自动扫描坐标" Margin="6,4,0,0" Padding="14,8" Click="AutoScanCoordinate_Click" />
                    <Button Content="生成指针链" Margin="6,4,0,0" Padding="14,8" Click="GeneratePointerChain_Click" />
                    <Button Content="读取坐标" Margin="6,4,0,0" Padding="14,8" Click="ReadCoordinate_Click" />
                    <Button Content="未知扫描开始" Margin="6,4,0,0" Padding="14,8" Click="UnknownScanStart_Click" />
                    <Button Content="静止过滤" Margin="6,4,0,0" Padding="14,8" Click="UnknownScanUnchanged_Click" />
                    <Button Content="移动过滤" Margin="6,4,0,0" Padding="14,8" Click="UnknownScanChanged_Click" />
                    <Button Content="使用候选" Margin="6,4,0,0" Padding="14,8" Click="UnknownScanUse_Click" />
                    <TextBox x:Name="CurrencyCurrentBox" Width="110" Margin="18,4,0,0" VerticalContentAlignment="Center" IsReadOnly="True" ToolTip="通过游戏 API 读取的当前货币数量" />
                    <TextBox x:Name="CurrencyTargetBox" Width="110" Margin="18,4,0,0" VerticalContentAlignment="Center" ToolTip="输入要写入的目标货币数量" />
                    <Button Content="读取货币(API)" Margin="6,4,0,0" Padding="14,8" Click="CurrencyApiRead_Click" />
                    <Button Content="设置货币(API)" Margin="6,4,0,0" Padding="14,8" Click="CurrencyApiSet_Click" />
                </WrapPanel>
            </Expander>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="传送到选中点" Padding="16,8" Click="TeleportSelected_Click" />
                <Button Content="删除选中点" Margin="8,0,0,0" Padding="16,8" Click="DeleteSelected_Click" />
                <Button Content="保存列表" Margin="8,0,0,0" Padding="16,8" Click="SavePoints_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="导入 GI 列表" Padding="16,8" Click="ImportGi_Click" />
                <Button Content="导出 GI 列表" Margin="8,0,0,0" Padding="16,8" Click="ExportGi_Click" />
                <Button Content="打开数据目录" Margin="8,0,0,0" Padding="16,8" Click="OpenDataDirectory_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
